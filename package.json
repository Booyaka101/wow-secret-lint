{
  "name": "wow-secret-lint",
  "version": "1.9.0",
  "description": "Maps where a WoW retail addon touches Blizzard's secret-value API, and gates CI on the one error that is certain.",
  "type": "module",
  "license": "MIT",
  "author": "Booyaka101",
  "homepage": "https://github.com/Booyaka101/wow-secret-lint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Booyaka101/wow-secret-lint.git"
  },
  "bugs": {
    "url": "https://github.com/Booyaka101/wow-secret-lint/issues"
  },
  "keywords": [
    "wow",
    "warcraft",
    "addon",
    "lua",
    "lint",
    "secret-values",
    "static-analysis"
  ],
  "bin": {
    "wow-secret-lint": "bin/wow-secret-lint.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "action/",
    "vendor/",
    "data/api-snapshot.json",
    "data/forever-presence.json",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "lint:self": "node bin/wow-secret-lint.mjs test/fixtures/clean",
    "action": "node action/index.mjs",
    "validate:action": "node scripts/validate-action.mjs"
  },
  "dependencies": {
    "luaparse": "^0.3.1"
  },
  "devDependencies": {
    "@action-validator/cli": "^0.6.0",
    "vitest": "^2.1.9"
  }
}
